{
  "name": "o-pharmacy-desktop",
  "private": true,
  "version": "0.7.16",
  "description": "O Pharmacy desktop window (Electron, ADR-0002) over the local Hub",
  "author": "O Pharmacy",
  "main": "main.cjs",
  "testBuild": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.opharmacy.desktop",
    "productName": "O Pharmacy",
    "files": [
      "main.cjs",
      "preload.cjs",
      "splash.html",
      "print-raw.ps1",
      "setup.html",
      "package.json",
      "tray.png",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "res/hub",
        "to": "hub"
      },
      {
        "from": "res/web",
        "to": "web"
      },
      {
        "from": "res/node",
        "to": "node"
      },
      {
        "from": "res/extra",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "O-Pharmacy-Setup-${version}.exe",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "O Pharmacy",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "directories": {
      "output": "release"
    }
  }
}
