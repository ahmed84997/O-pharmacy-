      ],
      "@o-pharmacy/inventory": [
        "../../packages/inventory/src/index.ts"
      ],
      "@o-pharmacy/pos": [
        "../../packages/pos/src/index.ts"
      ],
      "@o-pharmacy/ops": [
        "../../packages/ops/src/index.ts"
      ],
      "@o-pharmacy/accounts": [
        "../../packages/accounts/src/index.ts"
      ],
      "@o-pharmacy/hr": [
        "../../packages/hr/src/index.ts"
      ],
      "@o-pharmacy/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@o-pharmacy/reports": [
        "../../packages/reports/src/index.ts"
      ],
      "@o-pharmacy/eta": [
        "../../packages/eta/src/index.ts"
      ],
      "@o-pharmacy/print": [
        "../../packages/print/src/index.ts"
